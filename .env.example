# Backend Config
JWT_SECRET=your_jwt_secret_here
PORT=3001

# SMTP Mail Server Config
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password

# ThingSpeak Sensor Config
THINGSPEAK_CHANNEL_ID=your_thingspeak_channel_id
THINGSPEAK_API_KEY=your_thingspeak_api_key

# Frontend Sensor Config
VITE_THINGSPEAK_CHANNEL_ID=your_thingspeak_channel_id
VITE_THINGSPEAK_API_KEY=your_thingspeak_api_key

# Supabase Config
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key
# Service-role key (required for admin user management + the compliance monitor)
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key

# Admin Login (overrides the hardcoded demo credentials)
ADMIN_EMAIL=tharani.t.ciet@gmail.com
ADMIN_PASSWORD=HydroNexa@2026

# Gemini AI API Key
VITE_GEMINI_API_KEY=your_gemini_api_key
